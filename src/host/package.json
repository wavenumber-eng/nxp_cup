{
  "name": "nxp-cup-host-tests",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/build-web.ps1",
    "check:dashboard": "powershell -NoProfile -ExecutionPolicy Bypass -File ../web/build.ps1 -Check",
    "check:lessons": "python ../../scripts/tools/build_learning_pages.py --check",
    "test": "npm run check:dashboard && npm run check:lessons && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
